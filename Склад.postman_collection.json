{
  "info": {
    "name": "MongoDB · Вариант 7 · Склад",
    "description": "Запросы к локальному API остатков. POST в папке «Запись» добавляет документ. Для исходной статистики сначала выполните запросы чтения.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Чтение",
      "item": [
        {
          "name": "Все остатки",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Проверка результата', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Остаток от 100",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/items?minQuantity=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Проверка результата', () => {",
                  "  pm.expect(pm.response.json().every(item => item.quantity >= 100)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Поставщик ТехСнаб",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/items?supplier=tekhsnab"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Проверка результата', () => {",
                  "  pm.expect(pm.response.json().every(item => item.supplierId === 'tekhsnab')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Выдача в истории",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/items?action=issue"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Проверка результата', () => {",
                  "  pm.expect(pm.response.json().every(item => item.history.some(entry => entry.action === 'issue'))).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Поиск по названию",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/items?search=%D0%BA%D0%B0%D0%B1%D0%B5%D0%BB%D1%8C"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Проверка результата', () => {",
                  "  pm.expect(pm.response.json().every(item => /кабель/i.test(item.name))).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Два наибольших остатка",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/items?sort=quantity_desc&limit=2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Проверка результата', () => {",
                  "  const rows = pm.response.json();",
                  "  pm.expect(rows.length).to.be.at.most(2);",
                  "  if (rows.length === 2) pm.expect(rows[0].quantity).to.be.at.least(rows[1].quantity);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Статистика по поставщикам",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/items/stats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Проверка результата', () => {",
                  "  pm.expect(pm.response.json().every(row => row.count > 0 && row.avgQuantity === row.totalQuantity / row.count)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Список поставщиков",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/suppliers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Проверка результата', () => {",
                  "  pm.expect(pm.response.json().some(supplier => supplier._id === 'tekhsnab')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Запись",
      "item": [
        {
          "name": "Добавить позицию",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Крепление для кабеля\",\n  \"quantity\": 25,\n  \"supplierId\": \"tekhsnab\",\n  \"location\": {\n    \"zone\": \"A\",\n    \"rack\": 2,\n    \"bin\": \"A-02-05\"\n  },\n  \"history\": [\n    {\n      \"action\": \"receipt\",\n      \"quantity\": 25,\n      \"at\": \"2026-11-15T05:00:00Z\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Проверка результата', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('_id');",
                  "  pm.expect(pm.response.json().location.bin).to.equal('A-02-05');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
